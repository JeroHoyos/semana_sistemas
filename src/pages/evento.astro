---
import Layout from '@/layouts/Layout.astro';
import '@/styles/global.css';
---

<Layout
	title="Actividad | Semana de Sistemas"
	description="Información de una actividad de la Semana de Sistemas en la Facultad de Minas."
	fonts="https://fonts.googleapis.com/css2?family=Alfa+Slab+One&family=Barlow:wght@400;500;600&family=Barlow+Condensed:wght@500;600;700&family=Cinzel:wght@600;700&family=Graduate&display=swap"
	nightRedirect
>
  <!-- HEADER: type and title (event.js fills it from the ?id= in the address) -->
  <header class="event-hero photo-bg photo-bg--auditorium">
    <div class="page-width">
      <a class="back-link" href="index.html#horario">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
        Volver al horario
      </a>
      <div class="event-hero__content" id="event-hero"></div>
    </div>
  </header>

  <main class="event page-width">

    <!-- INFO: facts, description, speaker and activities at the same time -->
    <article class="event__card" id="event-info"></article>

  </main>

  <!-- FOOTER -->
  <footer class="site-footer">
    <a class="site-footer__instagram" href="https://www.instagram.com/sistemasunalmed/" target="_blank" rel="noopener"
      title="Instagram de la representación de Ingeniería de Sistemas">
      <span class="site-footer__crest" id="footer-crest"></span>
      <span class="site-footer__handle">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/><circle cx="17.5" cy="6.5" r=".6" fill="currentColor"/></svg>
        @sistemasunalmed
      </span>
    </a>
    <p>Semana de Sistemas, Facultad de Minas, Medellín</p>
    <p class="site-footer__authors">Web hecha por <strong>Santiago Escobar Arias</strong> y <strong>Jerónimo Hoyos Botero</strong></p>
    <p class="site-footer__disclaimer">Proyecto estudiantil sin ánimo de lucro. Iniciativa académica e informativa para la comunidad universitaria de la Universidad Nacional de Colombia — Sede Medellín.</p>
    <p class="site-footer__legal"><strong>Aviso de Propiedad Intelectual y Seguridad:</strong> El diseño, arquitectura de software, código fuente, experiencia de usuario (UX/UI), herramientas interactivas e imágenes de vista previa están protegidos por la Ley 23 de 1982, Decisión Andina 351 y Arts. 270 y 271 del Código Penal Colombiano. Queda prohibida la reproducción parcial o total, plagio, copia de funcionalidades o ingeniería inversa sin autorización previa y por escrito del autor. Los logotipos e identidad visual son obra de la representación estudiantil y su uso requiere autorización expresa de la misma. Cualquier intento de vulneración o alteración informática será sancionado conforme a la Ley 1273 de 2009 (Delitos Informáticos).</p>
    <p class="site-footer__copyright">© 2026. Todos los derechos reservados. <a href="politica-datos.html" class="site-footer__link">Política de Tratamiento de Datos Personales</a></p>
  </footer>

	<script>
		import '@/scripts/event';
		import '@/scripts/pre-register';
		import '@/scripts/brackets';
		import '@/scripts/secrets';

		// three.js is only downloaded for the athletics race, the activity with the 3D route map
		if (document.querySelector('#race-map')) import('@/scripts/race-map');
	</script>
</Layout>
